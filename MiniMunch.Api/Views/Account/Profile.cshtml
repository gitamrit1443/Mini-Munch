@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}
<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
        <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">My account</p>
        <h1 class="mt-3 text-4xl font-black text-cocoa">Profile</h1>
    </div>
    <form asp-action="Profile" method="post" class="rounded-[3rem] bg-white p-8 shadow-soft">
        @Html.AntiForgeryToken()
        <div class="grid gap-5 md:grid-cols-2">
            <div>
                <label class="form-label">Full name</label>
                <input asp-for="FullName" class="form-input" />
                <span asp-validation-for="FullName" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-input bg-stone-100" readonly />
            </div>
            <div>
                <label class="form-label">Phone</label>
                <input asp-for="PhoneNumber" class="form-input" />
            </div>
            <div>
                <label class="form-label">City</label>
                <input asp-for="City" class="form-input" />
            </div>
            <div class="md:col-span-2">
                <label class="form-label">Address</label>
                <input asp-for="AddressLine" class="form-input" />
            </div>
            <div>
                <label class="form-label">Pin code</label>
                <input asp-for="PinCode" class="form-input" />
            </div>
        </div>
        <button class="mt-7 rounded-full bg-cocoa px-7 py-4 font-black text-white shadow-soft">Save changes</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
