@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Admin Orders";
}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div>
        <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">Admin</p>
        <h1 class="mt-3 text-4xl font-black text-cocoa">Orders</h1>
    </div>
    <div class="mt-8 rounded-[3rem] bg-white p-6 shadow-soft">
        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
                <thead class="text-xs uppercase tracking-widest text-stone-400">
                    <tr><th class="py-3">Order</th><th>Customer</th><th>Phone</th><th>Status</th><th>Total</th><th></th></tr>
                </thead>
                <tbody class="divide-y divide-stone-100">
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="py-4 font-black text-cocoa">@order.OrderNumber</td>
                            <td>@order.CustomerName</td>
                            <td>@order.PhoneNumber</td>
                            <td><span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-700">@order.Status</span></td>
                            <td class="font-black">₹@order.TotalAmount</td>
                            <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="font-black text-cocoa underline decoration-honey decoration-4 underline-offset-4">Manage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
