@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Admin Products";
}
<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">Admin</p>
            <h1 class="mt-3 text-4xl font-black text-cocoa">Products</h1>
        </div>
        <a asp-action="CreateProduct" class="rounded-full bg-cocoa px-6 py-3 font-black text-white shadow-sm">New product</a>
    </div>
    <div class="mt-8 rounded-[3rem] bg-white p-6 shadow-soft">
        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
                <thead class="text-xs uppercase tracking-widest text-stone-400">
                    <tr><th class="py-3">Product</th><th>Category</th><th>Price</th><th>Status</th><th></th></tr>
                </thead>
                <tbody class="divide-y divide-stone-100">
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="py-4 font-black text-cocoa">@product.Name</td>
                            <td>@product.Category.Name</td>
                            <td class="font-black">₹@product.Price</td>
                            <td><span class="rounded-full @(product.IsAvailable ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700") px-3 py-1 text-xs font-black">@(product.IsAvailable ? "Available" : "Hidden")</span></td>
                            <td class="flex gap-3 py-4">
                                <a asp-action="EditProduct" asp-route-id="@product.Id" class="font-black text-cocoa underline decoration-honey decoration-4 underline-offset-4">Edit</a>
                                <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Hide this product from menu?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <button class="font-black text-red-600">Hide</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
