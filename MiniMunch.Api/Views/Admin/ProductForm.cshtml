@model ProductFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Product" : "Create Product";
    var action = Model.Id.HasValue ? "EditProduct" : "CreateProduct";
}
<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
        <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">Admin</p>
        <h1 class="mt-3 text-4xl font-black text-cocoa">@(Model.Id.HasValue ? "Edit product" : "Create product")</h1>
    </div>
    <form asp-action="@action" method="post" class="rounded-[3rem] bg-white p-8 shadow-soft">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm font-semibold text-red-600"></div>
        <div class="grid gap-5 md:grid-cols-2">
            <div>
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Category</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-input"></select>
                <span asp-validation-for="CategoryId" class="form-error"></span>
            </div>
            <div class="md:col-span-2">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" rows="4" class="form-input"></textarea>
                <span asp-validation-for="Description" class="form-error"></span>
            </div>
            <div class="md:col-span-2">
                <label class="form-label">Ingredients</label>
                <textarea asp-for="Ingredients" rows="3" class="form-input"></textarea>
                <span asp-validation-for="Ingredients" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Badge</label>
                <input asp-for="Badge" class="form-input" />
            </div>
            <div>
                <label class="form-label">Accent color</label>
                <input asp-for="AccentColor" class="form-input" />
            </div>
            <div>
                <label class="form-label">Price</label>
                <input asp-for="Price" class="form-input" />
                <span asp-validation-for="Price" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Calories</label>
                <input asp-for="Calories" class="form-input" />
                <span asp-validation-for="Calories" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Prep time minutes</label>
                <input asp-for="PrepTimeMinutes" class="form-input" />
                <span asp-validation-for="PrepTimeMinutes" class="form-error"></span>
            </div>
            <div>
                <label class="form-label">Sort order</label>
                <input asp-for="SortOrder" class="form-input" />
            </div>
            <label class="flex items-center gap-3 rounded-3xl bg-stone-50 p-5 font-bold text-stone-700">
                <input asp-for="IsAvailable" class="h-5 w-5 rounded border-stone-300" /> Available on menu
            </label>
        </div>
        <div class="mt-8 flex gap-3">
            <button class="rounded-full bg-cocoa px-7 py-4 font-black text-white shadow-soft">Save</button>
            <a asp-action="Products" class="rounded-full bg-stone-100 px-7 py-4 font-black text-cocoa">Cancel</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
