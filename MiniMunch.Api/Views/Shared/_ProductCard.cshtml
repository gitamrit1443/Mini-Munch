@model Product
<article class="group overflow-hidden rounded-[2rem] border border-stone-100 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-soft">
    <a asp-controller="Menu" asp-action="Details" asp-route-slug="@Model.Slug" class="block">
        <div class="grid h-48 place-items-center rounded-[1.5rem] bg-gradient-to-br from-amber-100 via-orange-50 to-rose-100 text-7xl transition group-hover:scale-[1.02]">🥞</div>
        <div class="mt-5 flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-honey">@Model.Category.Name</p>
                <h3 class="mt-1 text-xl font-black text-cocoa">@Model.Name</h3>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Badge))
            {
                <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-700">@Model.Badge</span>
            }
        </div>
        <p class="mt-3 line-clamp-2 text-sm leading-6 text-stone-600">@Model.Description</p>
    </a>
    <div class="mt-5 flex items-center justify-between">
        <div>
            <div class="text-2xl font-black text-cocoa">₹@Model.Price</div>
            <div class="text-xs font-bold text-stone-400">@Model.PrepTimeMinutes min · @Model.Calories kcal</div>
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <button class="rounded-full bg-cocoa px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-stone-800">Add</button>
        </form>
    </div>
</article>
