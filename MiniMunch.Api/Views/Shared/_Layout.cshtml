@using System.Security.Claims
@{
    var isAdmin = User.IsInRole("Admin");
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini Munch</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cocoa: '#2a1711',
                        cream: '#fff7e8',
                        honey: '#f59e0b',
                        berry: '#be123c'
                    },
                    boxShadow: {
                        soft: '0 24px 80px rgba(42, 23, 17, 0.12)'
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-[#fffaf1] text-stone-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/60 bg-[#fffaf1]/85 backdrop-blur-xl">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
            <a asp-controller="Home" asp-action="Index" class="group flex items-center gap-3">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-cocoa text-xl text-white shadow-soft transition group-hover:-rotate-6">🥞</span>
                <span>
                    <span class="block text-lg font-black tracking-tight text-cocoa">Mini Munch</span>
                    <span class="block text-xs font-semibold uppercase tracking-[0.25em] text-honey">Pancake Studio</span>
                </span>
            </a>

            <div class="hidden items-center gap-7 text-sm font-semibold text-stone-700 md:flex">
                <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                <a asp-controller="Menu" asp-action="Index" class="nav-link">Menu</a>
                <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                <a asp-controller="Demo" asp-action="Flow" class="nav-link">Demo Flow</a>
                @if (signedIn)
                {
                    <a asp-controller="Cart" asp-action="Index" class="nav-link">Cart</a>
                    <a asp-controller="Orders" asp-action="Index" class="nav-link">Orders</a>
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Admin</a>
                    }
                }
            </div>

            <div class="flex items-center gap-3">
                @if (signedIn)
                {
                    <a asp-controller="Account" asp-action="Profile" class="hidden rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-bold text-stone-700 shadow-sm transition hover:border-honey hover:text-cocoa sm:inline-flex">
                        @User.GetUserDisplayName()
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="rounded-full bg-cocoa px-5 py-2.5 text-sm font-bold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-stone-800">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-bold text-stone-700 shadow-sm transition hover:border-honey">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="rounded-full bg-cocoa px-5 py-2.5 text-sm font-bold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-stone-800">Sign up</a>
                }
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["Success"] is not null)
        {
            <div class="mx-auto mt-5 max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="rounded-3xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800 shadow-sm">@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] is not null)
        {
            <div class="mx-auto mt-5 max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="rounded-3xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-800 shadow-sm">@TempData["Error"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="mt-24 border-t border-stone-200 bg-cocoa text-white">
        <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
            <div>
                <div class="mb-3 text-2xl font-black">Mini Munch</div>
                <p class="max-w-sm text-sm leading-6 text-stone-300">Artisan pancakes handcrafted daily with premium toppings and a smooth ordering experience.</p>
            </div>
            <div>
                <div class="mb-3 text-sm font-black uppercase tracking-[0.25em] text-honey">Explore</div>
                <div class="grid gap-2 text-sm text-stone-300">
                    <a asp-controller="Menu" asp-action="Index" class="hover:text-white">Menu</a>
                    <a asp-controller="Cart" asp-action="Index" class="hover:text-white">Cart</a>
                    <a asp-controller="Orders" asp-action="Index" class="hover:text-white">Orders</a>
                </div>
            </div>
            <div>
                <div class="mb-3 text-sm font-black uppercase tracking-[0.25em] text-honey">Demo</div>
                <p class="text-sm leading-6 text-stone-300">Admin: admin@minimunch.local / Admin@123</p>
                <p class="text-sm leading-6 text-stone-300">Customer: customer@minimunch.local / Customer@123</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
