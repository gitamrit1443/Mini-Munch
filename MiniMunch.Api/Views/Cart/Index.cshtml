@model IReadOnlyList<CartItem>
@{
    ViewData["Title"] = "Cart";
    decimal subTotal = ViewBag.SubTotal ?? 0m;
    decimal deliveryFee = ViewBag.DeliveryFee ?? 0m;
}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
        <div>
            <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">Your order</p>
            <h1 class="mt-3 text-4xl font-black text-cocoa">Cart</h1>
        </div>
        <a asp-controller="Menu" asp-action="Index" class="rounded-full bg-white px-5 py-3 text-sm font-black text-cocoa shadow-sm">Add more</a>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-[3rem] bg-white p-10 text-center shadow-soft">
            <div class="text-6xl">🛒</div>
            <h2 class="mt-5 text-3xl font-black text-cocoa">Cart is empty</h2>
            <p class="mt-3 text-stone-600">Pick a stack from the menu.</p>
            <a asp-controller="Menu" asp-action="Index" class="mt-8 inline-flex rounded-full bg-cocoa px-7 py-4 font-black text-white">Open menu</a>
        </div>
    }
    else
    {
        <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
            <div class="space-y-4">
                @foreach (var item in Model)
                {
                    <div class="rounded-[2rem] bg-white p-5 shadow-sm">
                        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex items-center gap-4">
                                <div class="grid h-20 w-20 place-items-center rounded-3xl bg-amber-100 text-4xl">🥞</div>
                                <div>
                                    <h3 class="font-black text-cocoa">@item.Product.Name</h3>
                                    <p class="text-sm text-stone-500">₹@item.UnitPriceSnapshot each</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <form asp-action="Update" method="post" class="flex items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="10" class="w-20 rounded-full border border-stone-200 px-3 py-2 text-center font-black" />
                                    <button class="rounded-full bg-stone-100 px-4 py-2 text-sm font-black text-cocoa">Update</button>
                                </form>
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="rounded-full bg-red-50 px-4 py-2 text-sm font-black text-red-700">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <aside class="h-fit rounded-[2rem] bg-cocoa p-6 text-white shadow-soft">
                <h2 class="text-2xl font-black">Order summary</h2>
                <div class="mt-6 space-y-3 text-sm text-stone-300">
                    <div class="flex justify-between"><span>Subtotal</span><span class="font-black text-white">₹@subTotal</span></div>
                    <div class="flex justify-between"><span>Delivery</span><span class="font-black text-white">₹@deliveryFee</span></div>
                    <div class="border-t border-white/10 pt-4 text-lg font-black text-white flex justify-between"><span>Total</span><span>₹@(subTotal + deliveryFee)</span></div>
                </div>
                <a asp-action="Checkout" class="mt-7 flex justify-center rounded-full bg-honey px-6 py-4 font-black text-cocoa">Checkout</a>
            </aside>
        </div>
    }
</section>
