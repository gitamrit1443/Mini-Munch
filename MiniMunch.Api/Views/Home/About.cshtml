@{
    ViewData["Title"] = "About";
}
<section class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="rounded-[3rem] bg-white p-8 shadow-soft md:p-12">
        <p class="text-sm font-black uppercase tracking-[0.25em] text-honey">About Mini Munch</p>
        <h1 class="mt-4 text-5xl font-black tracking-tight text-cocoa">A premium pancake brand rebuilt as an MVC ordering app.</h1>
        <p class="mt-6 text-lg leading-8 text-stone-600">This version keeps the original pancake-store concept but adds a proper MVC backend, SQL Server database, secure JWT login, role-based admin screens, cart and order workflows.</p>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
            <div class="rounded-3xl bg-amber-50 p-6">
                <div class="text-3xl">🥞</div>
                <h3 class="mt-4 font-black text-cocoa">Menu first</h3>
                <p class="mt-2 text-sm leading-6 text-stone-600">The UI focuses on product discovery and quick ordering.</p>
            </div>
            <div class="rounded-3xl bg-rose-50 p-6">
                <div class="text-3xl">🔐</div>
                <h3 class="mt-4 font-black text-cocoa">JWT auth</h3>
                <p class="mt-2 text-sm leading-6 text-stone-600">MVC pages are protected with JWT Bearer authentication via HttpOnly cookie.</p>
            </div>
            <div class="rounded-3xl bg-violet-50 p-6">
                <div class="text-3xl">📦</div>
                <h3 class="mt-4 font-black text-cocoa">Admin ready</h3>
                <p class="mt-2 text-sm leading-6 text-stone-600">Products and orders can be managed from a clean admin dashboard.</p>
            </div>
        </div>
    </div>
</section>
